@startuml seq_update_bat_level.puml
title ESP32 Internet Radio - Sequence Diagram (Update Battery Level)

box "Core" #LightBlue
participant "Core EventTask\n(IEventQueue)" as CET
participant "Ui EventTask\n(IEventQueue)" as UET
participant "AppController" as AC
end box

box "Services" #LightGreen
participant "UiService" as UI
participant "SensorService" as SS
end box

box "Common" #LightGray
participant "TaskRunner" as TR
participant "StopToken" as ST
end box

box "Adapters" #LightYellow
participant "AdcReader\n(IAdcReader)" as ADC
end box

box "ESP-IDF" #LightGray
participant "ESP-IDF" as IDF
end box

== Init ==
I2C -> IDF ++: initialize and create bus handle
return res
SS -> TR ++: start task that triggers measurements
return res

== Measurement == 
activate SS
SS ->  ADC ++: readRawBurst(common::BatteryAdcGpio, rawBuffer, BurstSize)
loop (size_t i = 0; i < BurstSize; ++i)
    ADC -> IDF ++: adc_oneshot_read(mUnitHandle, it->second.channel, &buffer[i]);
    return res
end
return res

SS -> SS: parse raw data and convert to %
SS -> CET ++: post(BatteryLevelUpdateEvent{})
return res

CET -> AC ++: onEvent(BatteryLevelUpdateEvent{})
activate CET
AC -> UET ++: post(BatteryLevelUpdateEvent{})
return res
return res

UET -> UI ++: onEvent(BatteryLevelUpdateEvent{})
activate UET
UI -> UI: prepare icon bytes
UI -> UI: show new icon
note left
    See seq_ui_events.puml for details
end note
return
@enduml
