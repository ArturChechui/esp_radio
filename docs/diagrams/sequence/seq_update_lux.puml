@startuml seq_update_lux.puml
title ESP32 Internet Radio - Sequence Diagram (Update Lux)

box "Core" #LightBlue
participant "Core EventTask\n(IEventQueue)" as CET
participant "AppController" as AC
end box

box "Services" #LightGreen
participant "InputService" as IS
participant "SensorService" as SS
end box

box "Common" #LightGray
participant "TaskRunner" as TR
participant "StopToken" as ST
end box

box "Adapters" #LightYellow
participant "I2cBus\n(II2cBus)" as I2C
end box

box "ESP-IDF" #LightGray
participant "ESP-IDF" as IDF
end box

== Init ==
I2C -> IDF ++: initialize and create bus handle
return res
SS -> TR ++: start task that triggers measurements
return res

== Measurement ==
activate SS
SS ->  I2C ++: writeBytes(addr, modeCmd.data(), modeCmd.size(), 100)
I2C -> IDF ++: i2c_master_transmit(dev, data, len, ticks)
return res
return res

SS -> ST ++: sleepMs(180)
return bool - if stoped

SS ->  I2C ++: readBytes(addr, data.data(), data.size(), 100)
I2C -> IDF ++: i2c_master_receive(dev, data, len, ticks)
return res
return res
SS -> SS: parse raw data
SS -> CET ++: post(LightLevelUpdateEvent{})
return res

CET -> AC ++: onEvent(LightLevelUpdateEvent{})
activate CET
AC -> IS ++: setMode(l.lux <= services::NightLux)
note right
Sets day/night mode to adapt the max volume level
end note
return res

@enduml
