@startuml class_core.puml
title ESP32 Internet Radio - Class Diagram (Core)

skinparam backgroundColor white
skinparam shadowing false
skinparam linetype ortho
skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
hide empty members
hide empty methods
hide empty fields
skinparam nodesep 25
skinparam ranksep 30

class AppContext {
    -mPersistentStorage: std::unique_ptr<adapters::PersistentStorage>
    -mWifiAdapter: std::unique_ptr<adapters::WifiClient>
    -mProvisioningPortal: std::unique_ptr<adapters::ProvisioningPortal>
    -mI2cBus: std::unique_ptr<adapters::I2cBus>
    -mI2sBus: std::unique_ptr<adapters::I2sBus>
    -mDisplay: std::unique_ptr<adapters::Display>
    -mGpioInput: std::unique_ptr<adapters::GpioInput>
    -mAdcReader: std::unique_ptr<adapters::AdcReader>
    -mStreamHttpClient: std::unique_ptr<adapters::HttpClient>
    -mJsonHttpClient: std::unique_ptr<adapters::HttpClient>
    -mMp3Decoder: std::unique_ptr<adapters::Mp3Decoder>
    -mFileSystem: std::unique_ptr<adapters::FileSystem>
    -mTaskRunner: std::unique_ptr<common::TaskRunner>
    -mStats: std::unique_ptr<common::AudioBufferStats>
    -mQueue: std::unique_ptr<common::Queue<uint32_t>>
    -mClock: std::unique_ptr<common::Clock>
    -mUiEventTask: std::unique_ptr<common::EventTask>
    -mCoreEventTask: std::unique_ptr<common::EventTask>
    -mJsonParser: std::unique_ptr<common::JsonParser>
    -mWifiService: std::unique_ptr<services::WifiService>
    -mInputService: std::unique_ptr<services::InputService>
    -mPlayerService: std::unique_ptr<services::PlayerService>
    -mStationRepository: std::unique_ptr<services::StationRepository>
    -mUiService: std::unique_ptr<services::UiService>
    -mSensorService: std::unique_ptr<services::SensorService>
    -mAppController: std::unique_ptr<AppController>
}

class AppController {
    -mWifiService: services::IWifiService&
    -mPlayerService: services::IPlayerService&
    -mStationRepository: services::IStationRepository&
    -mSensorService: services::ISensorService&
    -mInputService: services::IInputService&
    -mHttpClient: adapters::IHttpClient&
    -mFileSystem: adapters::IFileSystem&
    -mJsonParser: common::IJsonParser&
    -mUiEventQueue: common::IEventQueue&
    -mCurrentCmd: std::unique_ptr<commands::ICommand> 
}

interface IEventHandler {
    +onEvent(event: const AppEvent&): void
}

interface IEventQueue
interface IWifiService
interface IPlayerService
interface IStationRepository
interface ISensorService
interface IInputService
interface IHttpClient
interface IFileSystem
interface IJsonParser
interface IEventQueue
interface ICommand

class PersistentStorage
class WifiClient
class ProvisioningPortal
class I2cBus
class I2sBus
class Display
class GpioInput
class AdcReader
class HttpClient
class Mp3Decoder
class FileSystem
class TaskRunner
class AudioBufferStats
class Queue<uint32_t>
class Clock
class EventTask
class JsonParser
class WifiService
class InputService
class PlayerService
class StationRepository
class UiService
class SensorService
class AppController

AppContext *-up- PersistentStorage
AppContext *-up- WifiClient
AppContext *-up- ProvisioningPortal
AppContext *-up- I2cBus
AppContext *-up- I2sBus
AppContext *-up- Display
AppContext *-up- GpioInput
AppContext *-up- AdcReader
AppContext *-up- HttpClient
AppContext *-up- Mp3Decoder
AppContext *-up- FileSystem
AppContext *-up- TaskRunner
AppContext *-up- AudioBufferStats
AppContext *-up- Queue
AppContext *-up- Clock
AppContext *-up- EventTask
AppContext *-up- JsonParser
AppContext *-up- WifiService
AppContext *-up- InputService
AppContext *-up- PlayerService
AppContext *-up- StationRepository
AppContext *-up- UiService
AppContext *-up- SensorService
AppContext *-down- AppController

AppController .left.|> IEventHandler
AppController --> IWifiService
AppController --> IPlayerService
AppController --> IStationRepository
AppController --> ISensorService
AppController --> IInputService
AppController --> IHttpClient
AppController --> IFileSystem
AppController --> IJsonParser
AppController --> IEventQueue
AppController *-right- ICommand

@enduml
